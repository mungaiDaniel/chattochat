# Copy to .env and adjust. NEVER commit the real .env file.

# development | production   (tests select "testing" themselves)
APP_ENV=development

# Required in production; random per-process values are generated in development.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Leave unset in development to use a local SQLite file.
# PostgreSQL: postgresql://chat2chat:chat2chat@localhost:5432/chat2chat
DATABASE_URL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Optional
JWT_ACCESS_MINUTES=60
UPLOAD_FOLDER=
